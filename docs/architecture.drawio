<mxfile host="app.diagrams.net" type="device">
  <diagram name="Supergoal Architectuur" id="supergoal-arch">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Supergoal" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="22" width="420" height="32" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Plan samen, bouw autonoom, bewijs onafhankelijk. Een skill voor Claude Code en Codex." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#6b6b73;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="760" height="22" as="geometry" />
        </mxCell>

        <mxCell id="box" value="Autonome run onder een /goal&#10;fase voor fase, ook urenlang, zonder babysitten" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f1f4;strokeColor=#c9c9d1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=12;fontColor=#3a3a42;" vertex="1" parent="1">
          <mxGeometry x="340" y="488" width="520" height="258" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="Jouw taak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="104" width="340" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="1. Plannen samen&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;interview, een scherpe vraag per keer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="430" y="188" width="340" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="2. Context verzamelen&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;vier bronnen, een check en een tegencheck&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="430" y="284" width="340" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="3. Plan-review&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;jij keurt het plan goed (de enige stop)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="430" y="380" width="340" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Generator bouwt de fase&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;en levert ruw bewijs op, geen oordeel&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="430" y="552" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="Onafhankelijke evaluator&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;doet elke check zelf opnieuw&lt;/font&gt;&lt;br&gt;&lt;b&gt;ACCEPT of REJECT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C7DCF7;strokeColor=#4f79b0;strokeWidth=2;fontSize=15;fontColor=#16314f;" vertex="1" parent="1">
          <mxGeometry x="430" y="652" width="340" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="Eindaudit tegen het plan&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;opnieuw, tegen de oorspronkelijke opdracht&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="430" y="788" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="Klaar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#5d8a3a;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="882" width="240" height="56" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8a8a93;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8a8a93;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8a8a93;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8a8a93;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8a8a93;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="ACCEPT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5d8a3a;strokeWidth=2.5;endArrow=block;fontSize=11;fontColor=#5d8a3a;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8a8a93;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ereject" value="REJECT: herstel, max 3x" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c0392b;strokeWidth=2;dashed=1;endArrow=block;fontSize=10;fontColor=#c0392b;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s2" value="Eerst echt uitzoeken&#10;Code, docs, MCP's en skills. Een check of het genoeg is, plus een die juist een gat probeert te vinden." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3A3;strokeColor=#D9B40A;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=1;fontColor=#5b4b00;" vertex="1" parent="1">
          <mxGeometry x="28" y="276" width="286" height="86" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Overleeft lange runs&#10;Plan en voortgang op schijf, dus context-verlies gooit niks weg." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3A3;strokeColor=#D9B40A;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=1;fontColor=#5b4b00;" vertex="1" parent="1">
          <mxGeometry x="28" y="540" width="286" height="72" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Stuk? Terugrollen&#10;Een regressie gaat terug naar de baseline van de vorige fase." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3A3;strokeColor=#D9B40A;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=1;fontColor=#5b4b00;" vertex="1" parent="1">
          <mxGeometry x="28" y="628" width="286" height="72" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="Jij blijft de architect&#10;Hij praat je bij met artikelen en scenario's, en vraagt een keuze per keer met een aanbeveling." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3A3;strokeColor=#D9B40A;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=1;fontColor=#5b4b00;" vertex="1" parent="1">
          <mxGeometry x="886" y="176" width="286" height="86" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="De kern van het verschil&#10;De bouwer keurt nooit zijn eigen werk. De evaluator draait de echte app en bewijst het gedrag, niet alleen 'tests groen'." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3A3;strokeColor=#D9B40A;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=1;fontColor=#5b4b00;" vertex="1" parent="1">
          <mxGeometry x="886" y="640" width="286" height="100" as="geometry" />
        </mxCell>

        <mxCell id="lgbox" value="Legenda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e0e0e6;verticalAlign=top;align=left;fontSize=12;fontStyle=1;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="886" y="800" width="286" height="150" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="invoer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="902" y="836" width="120" height="22" as="geometry" /></mxCell>
        <mxCell id="lg2" value="plannen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="902" y="864" width="120" height="22" as="geometry" /></mxCell>
        <mxCell id="lg3" value="bouwen en bewijzen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="902" y="892" width="150" height="22" as="geometry" /></mxCell>
        <mxCell id="lg4" value="jij beslist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="902" y="920" width="120" height="22" as="geometry" /></mxCell>
        <mxCell id="lg5" value="klaar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="836" width="120" height="22" as="geometry" /></mxCell>
        <mxCell id="lg6" value="uitleg (sticky note)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3A3;strokeColor=#D9B40A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="864" width="120" height="24" as="geometry" /></mxCell>

        <mxCell id="sdispatch" value="Kies de dispatch&#10;Op vraag en budget: /goal als standaard, Workflow-swarms per fase alleen met credits, of /loop voor terugkerende taken." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3A3;strokeColor=#D9B40A;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=1;fontColor=#5b4b00;" vertex="1" parent="1">
          <mxGeometry x="28" y="372" width="286" height="96" as="geometry" />
        </mxCell>
        <mxCell id="steam" value="Per fase een team&#10;De bouwer mag een zwerm specialisten opzetten, elk met een eigen skillset. Mist er een skill, dan haalt hij die van skills.sh of schrijft hem." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3A3;strokeColor=#D9B40A;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=1;fontColor=#5b4b00;" vertex="1" parent="1">
          <mxGeometry x="886" y="472" width="286" height="98" as="geometry" />
        </mxCell>

