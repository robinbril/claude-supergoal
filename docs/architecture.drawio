<mxfile host="app.diagrams.net" type="device">
  <diagram name="Supergoal Architectuur" id="supergoal-arch">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Supergoal: Agentic Context Assembly" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1120" height="36" as="geometry" />
        </mxCell>
        <mxCell id="meta" value="Cross-corpus fanout voor de planning. Daarna bouwt de generator en bewijst een onafhankelijke evaluator elke fase op het draaiende artefact." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1120" height="22" as="geometry" />
        </mxCell>

        <mxCell id="a_user_orch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#888888;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="user" target="orch"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_orch_qr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#888888;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="orch" target="qr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_qr_frame" value="fanout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;fontSize=12;" edge="1" parent="1" source="qr" target="frame"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_frame_judge" value="snippets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;fontSize=12;" edge="1" parent="1" source="frame" target="judge"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_judge_qr" value="insufficient: gaps + redenen (max 3 rondes)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=2;endArrow=block;fontSize=11;fontColor=#B85450;dashed=1;" edge="1" parent="1" source="judge" target="qr">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="490" y="340" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a_judge_synth" value="voldoende context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=3;endArrow=block;fontSize=12;fontColor=#5d8a3a;" edge="1" parent="1" source="judge" target="synth"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_synth_decomp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#888888;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="synth" target="decomp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_decomp_gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#888888;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="decomp" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_gate_goal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#888888;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="gate" target="goal"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_goal_done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#888888;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="goal" target="done"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="frame" value="" tooltip="Stage 2b: dispatcht sub-queries naar vier corpora parallel of sequentieel. Elke worker retourneert brongetagde snippets." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="610" y="95" width="540" height="215" as="geometry" />
        </mxCell>
        <mxCell id="frametitle" value="Cross-Corpus Retrieval (Stage 2b)" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="105" width="480" height="24" as="geometry" />
        </mxCell>
        <mxCell id="framesub" value="gerichte queries, parallel via subagents waar beschikbaar" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="640" y="128" width="480" height="18" as="geometry" />
        </mxCell>
        <mxCell id="code" value="Code&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;recon + grep&lt;/font&gt;" tooltip="Draait recon-scripts en beantwoordt repo-vragen met file:line bewijs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="640" y="158" width="115" height="60" as="geometry" />
        </mxCell>
        <mxCell id="docs" value="Docs&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Context7 / Web&lt;/font&gt;" tooltip="Zoekt actuele API-docs via Context7 of WebFetch met versie-pinning." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="765" y="158" width="115" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mcps" value="MCPs&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;aangesloten&lt;/font&gt;" tooltip="Controleert aangesloten MCP-servers op relevante tools en data." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="890" y="158" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="skills" value="Skills&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;skill-finder&lt;/font&gt;" tooltip="Inventariseert beschikbare skills die matchen met het taakdomein." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1010" y="158" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="framenote" value="elke corpus retourneert brongetagde snippets, nooit rauwe dumps" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="640" y="270" width="490" height="24" as="geometry" />
        </mxCell>

        <mxCell id="user" value="Gebruikerstaak" tooltip="Startpunt: de gebruiker beschrijft wat er gebouwd, gefixt of verscheept moet worden." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="orch" value="Orchestrator&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Stage 0-1: memory + intake&lt;/font&gt;" tooltip="Laadt memory, detecteert tools (Context7, WebSearch, MCPs), stelt verduidelijkingsvragen bij ontbrekende informatie." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="210" y="160" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="qr" value="Planner &amp;amp; Query Rewriter&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Stage 2a&lt;/font&gt;" tooltip="Herschrijft de taak naar gerichte sub-queries per open planningsvraag. Schrijft naar queries.md." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="160" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="judge" value="Sufficient-Context Judge +&lt;br&gt;Adversarial Prober&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Stage 2c: inline judges&lt;/font&gt;" tooltip="Twee judges met tegengestelde bias. De eerste zoekt compleetheid, de tweede probeert een gat te vinden. INSUFFICIENT triggert retry (max 3 rondes)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="610" y="370" width="320" height="70" as="geometry" />
        </mxCell>

        <mxCell id="synth" value="Synthese&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Stage 3&lt;/font&gt;" tooltip="Destilleert risico's en afhankelijkheden uit de verzamelde context. Schrijft THINKING.md." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="980" y="370" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="decomp" value="Faseopdeling&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Stage 4-5&lt;/font&gt;" tooltip="Splitst werk in verifieerbare fasen met criteria, mandatory commands en rollback-doelen. Laatste fase: Polish &amp; Harden." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="980" y="480" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="Planreview (HTML + tekst)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;menselijke gate, Stage 6&lt;/font&gt;" tooltip="Enige goedkeuringsstap. Rendert review.html + tekst. Revisie-opties: Start now, Adjust assumption, Tweak phase, Restructure phases." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="760" y="480" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="goal" value="/goal run&lt;br&gt;generator bouwt, evaluator bewijst&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Stage 7 + final audit&lt;/font&gt;" tooltip="Een /goal dispatch. Per fase: de generator bouwt en print ruw bewijs zonder oordeel; een onafhankelijke evaluator herdraait elke check zelf op het draaiende artefact, blind voor het generator-relaas, en geeft ACCEPT of REJECT. 3-strike recovery, rollback naar de fase-baseline, memory writeback. Final audit herverifieert tegen de oorspronkelijke ROADMAP.md." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="540" y="480" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="done" value="Klaar" tooltip="Alle fasen voltooid, audit geslaagd, SUPERGOAL_RUN_COMPLETE verschenen in het transcript." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="590" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Legenda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;verticalAlign=top;align=left;fontSize=12;fontStyle=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="290" height="180" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="Invoer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="400" width="80" height="24" as="geometry" /></mxCell>
        <mxCell id="lg2" value="Orchestratie / planning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="145" y="400" width="170" height="24" as="geometry" /></mxCell>
        <mxCell id="lg3" value="Retrieval-corpus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="432" width="120" height="24" as="geometry" /></mxCell>
        <mxCell id="lg4" value="Judge / synthese / uitvoering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="185" y="432" width="130" height="24" as="geometry" /></mxCell>
        <mxCell id="lg5" value="Menselijke gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="464" width="120" height="24" as="geometry" /></mxCell>
        <mxCell id="lg6" value="Onvoldoende-context loop" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="55" y="500" width="250" height="20" as="geometry" /></mxCell>
        <mxCell id="lg6b" value="(gestippeld rood = retry met verfijnde queries)" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="55" y="520" width="260" height="20" as="geometry" /></mxCell>

        <mxCell id="note1" value="Jij blijft de architect. De skill praat je bij met artikelen en scenario's, en vraagt een keuze per keer met een aanbeveling." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3A3;strokeColor=#D9B40A;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="330" height="96" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="De bouwer keurt nooit zijn eigen werk. De onafhankelijke evaluator draait de echte app en bewijst het gedrag, niet alleen 'tests groen'." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3A3;strokeColor=#D9B40A;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="680" width="330" height="96" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="Gebouwd voor lange runs: plan en voortgang op schijf, rollback bij regressie, en een eindaudit tegen het oorspronkelijke plan." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3A3;strokeColor=#D9B40A;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="680" width="330" height="96" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
